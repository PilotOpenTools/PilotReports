<Window x:Class="Reports.Manager.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Сравнение отчёта"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="DiffRowTemplate">
            <Border x:Name="Row" Padding="4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="46" Foreground="#999" TextAlignment="Right" Text="{Binding OldNo}" />
                    <TextBlock Width="46" Foreground="#999" TextAlignment="Right" Text="{Binding NewNo}" />
                    <TextBlock x:Name="Sign" Width="20" Margin="8,0,0,0" Text="{Binding Sign}" />
                    <TextBlock x:Name="LineText" Text="{Binding Text}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter TargetName="Row" Property="Background" Value="#E6FFEC" />
                    <Setter TargetName="Sign" Property="Foreground" Value="#1A7F37" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter TargetName="Row" Property="Background" Value="#FFEBE9" />
                    <Setter TargetName="Sign" Property="Foreground" Value="#CF222E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Header">
                    <Setter TargetName="Row" Property="Background" Value="#DDF4FF" />
                    <Setter TargetName="LineText" Property="Foreground" Value="#57606A" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="DiffList" TargetType="ListBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ItemTemplate" Value="{StaticResource DiffRowTemplate}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Header" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Legend" Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Padding="12,4" Content="Закрыть" IsCancel="True" />
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Padding="12,4" Margin="0,0,8,0" FontWeight="SemiBold" Click="OnUpdate" />
        </DockPanel>
        <TabControl Margin="0,10,0,0">
            <TabItem x:Name="ScriptTab">
                <ListBox x:Name="ScriptList" Style="{StaticResource DiffList}" />
            </TabItem>
            <TabItem x:Name="MarkupTab">
                <ListBox x:Name="MarkupList" Style="{StaticResource DiffList}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
