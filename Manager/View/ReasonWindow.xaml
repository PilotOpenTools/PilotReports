<Window x:Class="Reports.Manager.ReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Причина обновления отчёта"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="Header" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Details" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555" />
        <TextBlock Margin="0,12,0,4" TextWrapping="Wrap"
                   Text="Причина обновления (попадёт в историю версий отчёта в Pilot):" />
        <TextBox x:Name="ReasonBox" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        <TextBlock x:Name="Error" Margin="0,6,0,0" Foreground="#b35c00" TextWrapping="Wrap" />
        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="10,4" Margin="0,0,8,0" Content="Отмена" IsCancel="True" />
            <Button x:Name="OkButton" Padding="12,4" FontWeight="SemiBold" Content="Обновить отчёт" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
