<Window x:Class="Reports.Manager.ReportManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Reports.Manager"
        x:ClassModifier="internal"
        Title="Загрузить отчёт"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <!-- Вход в GitLab -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Padding="8,2" Margin="8,0,0,0" Content="Войти через браузер" Command="{Binding LoginBrowserCommand}"
                        Visibility="{Binding BrowserLoginAvailable, Converter={StaticResource BoolToVisibility}}" />
                <Button Padding="8,2" Margin="8,0,0,0" Content="Токен GitLab…" Command="{Binding SetTokenCommand}" />
                <Button Padding="8,2" Margin="8,0,0,0" Content="Выйти" Command="{Binding LogoutCommand}"
                        ToolTip="Удалить сохранённый токен этого пользователя с компьютера" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="#555" TextTrimming="CharacterEllipsis" Text="{Binding Account}" />
        </DockPanel>

        <!-- Статус -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#b35c00" Text="{Binding Status}" />
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Дерево папок и отчётов -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Padding="8,2" Margin="6,0,0,0" Content="Обновить" Command="{Binding RefreshCommand}"
                            ToolTip="Перечитать папки и отчёты из Pilot" />
                    <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="2"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="Поиск по имени отчёта или папки" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555" Text="{Binding TreeInfo}" />
                <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItemChanged="OnSelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:ReportNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="{Binding Icon}" />
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Выбранный отчёт -->
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ReportTitle}" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555" Text="{Binding PilotInfo}" />
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#555" Text="{Binding RepoInfo}" />
                    <TextBlock Margin="0,2,0,0">
                        <Hyperlink Command="{Binding OpenRepoCommand}">Открыть репозиторий в GitLab</Hyperlink>
                    </TextBlock>
                    <Button HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3" FontWeight="SemiBold" Content="Создать репозиторий…"
                            Command="{Binding CreateRepoCommand}" Visibility="{Binding RepoMissing, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Выбрать папку (подгруппу) в GitLab и создать репозиторий отчёта" />

                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding HasReport}">
                        <GroupBox Header="С диска" Padding="8,8,0,0">
                            <WrapPanel>
                                <Button Style="{StaticResource ActionButton}" FontWeight="SemiBold" Content="Загрузить .repx с диска…"
                                        Command="{Binding UploadCommand}"
                                        ToolTip="Выбрать файл .repx, указать причину и создать новую версию отчёта в Pilot" />
                                <Button Style="{StaticResource ActionButton}" Content="Сохранить .repx на диск…"
                                        Command="{Binding SaveLocalCommand}" ToolTip="Скачать текущую версию отчёта из Pilot" />
                            </WrapPanel>
                        </GroupBox>
                        <GroupBox Header="main - продовая версия" Margin="0,8,0,0" Padding="8,8,0,0">
                            <WrapPanel>
                                <Button Style="{StaticResource ActionButton}" Content="Сравнить с main" Command="{Binding CompareMainCommand}"
                                        ToolTip="Что отличается в Pilot от ветки main (скрипт и разметка)" />
                                <Button Style="{StaticResource ActionButton}" Content="Обновить из main…" Command="{Binding UpdateMainCommand}"
                                        ToolTip="Взять .repx из ветки main и создать новую версию отчёта в Pilot" />
                            </WrapPanel>
                        </GroupBox>
                        <GroupBox Header="dev - тестовая версия" Margin="0,8,0,0" Padding="8,8,0,0">
                            <WrapPanel>
                                <Button Style="{StaticResource ActionButton}" Content="Сравнить с dev" Command="{Binding CompareDevCommand}"
                                        ToolTip="Что отличается в Pilot от ветки dev (скрипт и разметка)" />
                                <Button Style="{StaticResource ActionButton}" Content="Обновить из dev…" Command="{Binding UpdateDevCommand}"
                                        ToolTip="Взять .repx из ветки dev и создать новую версию отчёта в Pilot" />
                            </WrapPanel>
                        </GroupBox>
                    </StackPanel>

                    <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Версии отчёта в Pilot" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Width="130" Binding="{Binding Created, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                        <DataGridTextColumn Header="Автор" Width="170" Binding="{Binding Author}" />
                        <DataGridTextColumn Header="Причина" Width="*" Binding="{Binding Reason}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
