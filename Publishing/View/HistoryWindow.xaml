<Window x:Class="Reports.Publishing.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="История изменений отчёта"
        Width="860"
        Height="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Padding="12,4" Content="Закрыть" IsCancel="True" />
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  MouseDoubleClick="OnOpen" ToolTip="Двойной щелчок - открыть коммит в GitLab">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Width="150" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                <DataGridTextColumn Header="Автор" Width="160" Binding="{Binding AuthorName}" />
                <DataGridTextColumn Header="Изменение" Width="*" Binding="{Binding Title}" />
                <DataGridTextColumn Header="Коммит" Width="90" Binding="{Binding ShortId}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
