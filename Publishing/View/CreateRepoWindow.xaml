<Window x:Class="Reports.Publishing.CreateRepoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Создание репозитория отчёта в GitLab"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="Header" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555"
                   Text="Будет создан проект с именем отчёта: в main - README.md и CHANGELOG.md, ветка dev от main. Сам отчёт уйдёт следующей отправкой." />

        <TextBlock Margin="0,12,0,4" Text="Имя репозитория (по нему модуль находит отчёт):" />
        <TextBox x:Name="NameBox" Padding="2" TextChanged="OnNameChanged" />

        <TextBlock Margin="0,12,0,4" Text="Папка (подгруппа) в группе отчётов:" />
        <ComboBox x:Name="FolderBox" SelectionChanged="OnFolderChanged">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding CanCreate}" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock x:Name="PilotFolder" Margin="0,4,0,0" Foreground="#666" FontSize="11" TextWrapping="Wrap" />

        <TextBlock x:Name="Error" Margin="0,10,0,0" Foreground="#b35c00" TextWrapping="Wrap" />
        <ProgressBar x:Name="Busy" Height="4" Margin="0,6,0,0" IsIndeterminate="True" />

        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="10,4" Margin="0,0,8,0" Content="Отмена" IsCancel="True" />
            <Button x:Name="CreateButton" Padding="12,4" FontWeight="SemiBold" Content="Создать репозиторий" IsEnabled="False" Click="OnCreate" />
        </StackPanel>
    </StackPanel>
</Window>
