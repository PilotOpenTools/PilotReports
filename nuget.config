<?xml version="1.0" encoding="utf-8"?>
<!--
  Источники пакетов модуля. cicd - реестр пакетов GitLab проекта client-modules/pilot-clientsdk (пакет Pilot.ClientSdk и другие пакеты Pilot.*).
  Адрес ниже - ПРИМЕР: замените gitlab.example.local:8080 и номер проекта (9) на свои. Атрибут allowInsecureConnections нужен
  только пока GitLab работает по http; при https удалите его.
  Без доступа к вашему GitLab: соберите пакет из исходников (README Reports, раздел 7), сделайте копию этого файла
  nuget.local.config с источником cicd = локальная папка и передайте -p:RestoreConfigFile=nuget.local.config.
  CI входит в него токеном job (шаг в build_module). На своей машине один раз добавьте вход личным токеном GitLab (read_api):
    dotnet nuget update source cicd -u <логин GitLab> -p <токен> -configfile %AppData%\NuGet\NuGet.Config
  (если источника cicd там ещё нет - dotnet nuget add source <адрес ниже> -n cicd -u … -p …). Подробнее - README Pilot.ClientSdk, 4.2 «Источник GitLab на своей машине».
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="cicd" value="http://gitlab.example.local:8080/api/v4/projects/9/packages/nuget/index.json" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="cicd">
      <package pattern="Pilot.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
